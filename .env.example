# Canonical production origin, no trailing slash. Used for canonical URLs, Open Graph,
# sitemap.xml, robots.txt, JSON-LD and /llms.txt. On Vercel it falls back to the
# project's production domain; everywhere else it falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Search console ownership tokens (optional) — the value of the verification meta tag.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
