# MailerLogic API key (server-only — never prefix with NEXT_PUBLIC_). Sent as the X-API-Key
# header by /api/contact to deliver contact-form notifications from notifications@hottminds.com.
MAILERLOGIC_API_KEY=

# MailerLogic API server (US: https://api.mailerlogic.net, EU: https://eu-api.mailerlogic.net).
MAILERLOGIC_BASE_URL=https://api.mailerlogic.net

# Contact form notification sender (must be on a MailerLogic-verified domain) and recipient.
CONTACT_FROM_EMAIL=notifications@hottminds.com
CONTACT_FROM_NAME=Hott Minds Website
CONTACT_TO_EMAIL=macinvestments40@yahoo.com
